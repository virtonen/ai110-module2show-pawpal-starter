classDiagram
    class Owner {
        +str id
        +str name
        +time day_start
        +time day_end
        +str preferences
        +list~Pet~ pets
        +int available_minutes
        +add_pet(pet)
        +remove_pet(pet_id)
        +get_pet(pet_id) Pet
        +get_all_tasks(pending_only, on) list~Task~
        +filter_tasks(pet_name, status, on) list~Task~
        +to_dict() dict
        +from_dict(data) Owner$
        +save_to_json(path)
        +load_from_json(path) Owner$
    }

    class Pet {
        +str id
        +str name
        +str species
        +str breed
        +int age
        +list~Task~ tasks
        +add_task(task)
        +remove_task(task_id)
        +complete_task(task_id, on) Task
        +get_pending_tasks(on) list~Task~
        +to_dict() dict
        +from_dict(data) Pet$
    }

    class Task {
        +str id
        +str pet_id
        +str title
        +Category category
        +int duration_minutes
        +Priority priority
        +time preferred_time
        +Frequency frequency
        +date due_date
        +bool completed
        +bool fixed
        +is_due(on) bool
        +is_overdue(on) bool
        +mark_complete(on) Task
        +update(changes)
        +to_dict() dict
        +from_dict(data) Task$
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Category {
        <<enumeration>>
        WALK
        FEEDING
        MEDS
        ENRICHMENT
        GROOMING
        OTHER
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class Scheduler {
        +Owner owner
        +generate_plan(plan_date) DailyPlan
        +find_conflicts(tasks, plan_date) list~Conflict~
        +next_available_slot(duration_minutes, plan_date, after) datetime
        +sort_by_time(tasks) list~Task~
        +filter_tasks(pet_name, status, on) list~Task~
        -pet_name(task) str
        -window(task, plan_date) tuple
        -sort_tasks(tasks) list~Task~
        -find_slot(task, busy, holds, day) datetime
        -nearest_slot(task, blocked, day) datetime
        -explain_scheduled(task, start) str
        -explain_skipped(task) str
    }

    class DailyPlan {
        +date plan_date
        +list~ScheduledTask~ scheduled
        +list~SkippedTask~ skipped
        +total_minutes() int
        +summary() str
    }

    class ScheduledTask {
        +Task task
        +str pet_name
        +datetime start
        +str reason
        +datetime end
    }

    class SkippedTask {
        +Task task
        +str reason
    }

    class Conflict {
        +tuple~Task~ tasks
        +str message
    }

    class _Day {
        <<NamedTuple>>
        +datetime start
        +datetime end
        +date date
    }

    class schedule_helpers {
        <<module functions>>
        sort_by_time(tasks) list~Task~
        _free_gaps(blocked, day) Iterator
        _is_free(start, end, busy) bool
    }

    Owner "1" o-- "*" Pet : has
    Pet "1" *-- "*" Task : has
    Task "*" --> "1" Pet : pet_id refers to
    Task --> Priority
    Task --> Category
    Task --> Frequency
    Task ..> Task : mark_complete creates next occurrence
    Scheduler --> Owner : reads tasks and day window from
    Scheduler ..> DailyPlan : creates
    Scheduler ..> Conflict : creates
    Scheduler ..> _Day : uses
    Scheduler ..> schedule_helpers : uses
    DailyPlan "1" *-- "*" ScheduledTask : contains
    DailyPlan "1" *-- "*" SkippedTask : contains
    ScheduledTask --> Task : wraps
    SkippedTask --> Task : wraps
    Conflict "1" --> "1..*" Task : reports
